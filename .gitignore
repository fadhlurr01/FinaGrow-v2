# ==========================================
# SECURITY & SECRETS (GOOGLE API KEYS & DB)
# ==========================================
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backend Laravel Secrets
backend/.env
backend/.env.*
!backend/.env.example
backend/.env.backup
backend/.env.production

# ==========================================
# DEPENDENCIES (DO NOT UPLOAD TO GITHUB)
# ==========================================
node_modules/
backend/vendor/
dist/
dist-ssr/
.vite/
.output/

# ==========================================
# LARAVEL STORAGE & CACHE
# ==========================================
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php
backend/.phpunit.result.cache

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# IDE & SYSTEM FILES
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
